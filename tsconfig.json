{
  "compilerOptions": {
    "lib": ["ES6", "ESNext", "DOM"],
    "module": "ES2015",
    "rootDir": "src",
    "target": "ES2023",
    "strict": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "declaration": true,
    "jsx": "react",
    "allowJs": true,
    "skipLibCheck": true
  },
  "include": ["src"],
  "exclude": ["src/tests"]
}
